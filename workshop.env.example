# cp workshop.env.example workshop.env，然后改下面几项（只在工作机上需要）
AWS_REGION=us-west-1
SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx      # parent 放在哪个子网（要能从你的电脑 ssh 进去）
SG_ID=sg-xxxxxxxxxxxxxxxxx              # 安全组，要放行你电脑的 22 端口
KEY_NAME=my-key                         # EC2 key pair 名字
PEM=~/.ssh/my-key.pem                   # 对应的私钥
